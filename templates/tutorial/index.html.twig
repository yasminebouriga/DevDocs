{% extends 'base.html.twig' %}

{% block title %}Accueil - DevDocs{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Derniers tutoriels techniques</h1>
</div>

<div class="row g-4">
    {% for tutorial in tutorials %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="mb-2">
                        <a href="{{ path('app_category_show', {id: tutorial.category.id}) }}" class="badge bg-primary text-decoration-none">
                            {{ tutorial.category.name }}
                        </a>
                    </div>
                    <h5 class="card-title">{{ tutorial.title }}</h5>
                    <p class="card-text text-muted small">
                        Par <strong>{{ tutorial.author.pseudonyme }}</strong> • {{ tutorial.createdAt|date('d/m/Y') }}
                    </p>
                    <p class="card-text">{{ tutorial.content|slice(0, 110) }}...</p>
                    <div class="mt-auto">
                        <div class="mb-3">
                            {% for tag in tutorial.tags %}
                                <a href="{{ path('app_tag_show', {id: tag.id}) }}" class="badge bg-secondary text-decoration-none">
                                    #{{ tag.name }}
                                </a>
                            {% endfor %}
                        </div>
                        <a href="{{ path('app_tutorial_show', {slug: tutorial.slug}) }}" class="btn btn-outline-primary btn-sm w-100">
                            Lire le tutoriel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
