{% extends 'base.html.twig' %}

{% block title %}{{ tutorial.title }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <article class="card shadow-sm p-4 mb-4">
            <div class="mb-2">
                <span class="badge bg-primary">{{ tutorial.category.name }}</span>
            </div>
            <h1 class="mb-3">{{ tutorial.title }}</h1>
            <p class="text-muted small">
                Publié par <strong>{{ tutorial.author.pseudonyme }}</strong> le {{ tutorial.createdAt|date('d/m/Y à H:i') }}
            </p>
            <hr>
            <div class="content my-3" style="white-space: pre-line;">
                {{ tutorial.content }}
            </div>
            <div class="mt-3">
                {% for tag in tutorial.tags %}
                    <span class="badge bg-secondary">#{{ tag.name }}</span>
                {% endfor %}
            </div>

            {# زر التعديل والحذف يظهران فقط لصاحب المقال عبر الـ Voter #}
            {% if is_granted('TUTORIAL_EDIT', tutorial) %}
                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a href="{{ path('app_tutorial_edit', {slug: tutorial.slug}) }}" class="btn btn-warning btn-sm">Modifier</a>
                    <form method="post" action="{{ path('app_tutorial_delete', {slug: tutorial.slug}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce tutoriel ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tutorial.id) }}">
                        <button class="btn btn-danger btn-sm">Supprimer</button>
                    </form>
                </div>
            {% endif %}
        </article>

        <!-- قسم التعليقات -->
        <section class="card shadow-sm p-4">
            <h3 class="mb-4">Commentaires ({{ tutorial.comments|length }})</h3>

            {% if app.user %}
                {{ form_start(commentForm, {attr: {class: 'mb-4'}}) }}
                {{ form_widget(commentForm) }}
                <button class="btn btn-primary btn-sm mt-2">Poster le commentaire</button>
                {{ form_end(commentForm) }}
            {% else %}
                <p class="alert alert-info">Veuillez vous <a href="{{ path('app_login') }}">connecter</a> pour laisser un commentaire.</p>
            {% endif %}

            <div class="comments-list">
                {% for comment in tutorial.comments %}
                    <div class="border-bottom py-3">
                        <div class="d-flex justify-content-between">
                            <strong>{{ comment.author.pseudonyme }}</strong>
                            <small class="text-muted">{{ comment.createdAt|date('d/m/Y H:i') }}</small>
                        </div>
                        <p class="mb-0 mt-2">{{ comment.content }}</p>
                    </div>
                {% else %}
                    <p class="text-muted">Aucun commentaire pour le moment. Soyez le premier à réagir !</p>
                {% endfor %}
            </div>
        </section>
    </div>
</div>
{% endblock %}